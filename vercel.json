{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "*/2 * * * *"
    }
  ]
}
